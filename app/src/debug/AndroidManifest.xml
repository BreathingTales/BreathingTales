<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        debug 빌드에만 더하는 권한. 앱이 실제로 쓰는 차량·음성 권한은 :data 매니페스트에 있고
        release·debug 모두에 합쳐진다. 여기에는 확인 화면(probe)과 시연 모드만 쓰는 것을 둔다.
    -->
    <!-- probe 전용: 주행 정보, 창문 상태 확인 (앱은 창문을 제어하지 않는다) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />

    <application>
        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:label="숨쉬는 동화 기술 확인" />
        <!-- probe 전용: 다른 앱이 오디오 포커스를 잠깐 가져가는 상황 (11 통합 테스트) -->
        <receiver
            android:name=".probe.FocusStealReceiver"
            android:exported="true" />
            <!--   디버깅용     -->
<!--        <intent-filter>-->
<!--            <action android:name="android.intent.action.MAIN" />-->
<!--            <category android:name="android.intent.category.LAUNCHER" />-->
<!--        </intent-filter>-->
    </application>
</manifest>
